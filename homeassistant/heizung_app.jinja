{#-
  Heizungs-App – Datenquelle in Home Assistant (Beispiel für eine einfache Installation)

  Ablegen als:   config/custom_templates/heizung_app.jinja
  Danach:        Entwicklerwerkzeuge → Aktionen → "homeassistant.reload_custom_templates"

  Anpassen musst du NUR die Liste "raeume" (und ggf. die Wetter-Entität).
  Jeder Raum braucht mindestens ein Thermostat (climate.*). Ein Fensterkontakt
  ist optional.

  Die App stellt bei dieser Vorlage die Solltemperatur direkt am Thermostat
  (climate.set_temperature). Hast du eigene Heizungs-Skripte, die einen Helfer
  lesen (input_number), trage stattdessen den Helfer als "wunsch_entity" ein –
  dann bedient die App nur den Helfer und deine Skripte bleiben zuständig.
  Alle Felder: siehe FORMAT.md im Repository.
-#}
{%- macro status() -%}
{%- set raeume = [
  {'id': 'wohnzimmer', 'label': 'Wohnzimmer', 'climate': 'climate.wohnzimmer', 'fenster': 'binary_sensor.fenster_wohnzimmer'},
  {'id': 'bad',        'label': 'Bad',        'climate': 'climate.bad'},
] -%}
{%- set wetter = 'weather.home' -%}

{%- set ns = namespace(r=[]) -%}
{%- for r in raeume -%}
  {%- set c = r.climate -%}
  {%- set heizt = is_state_attr(c, 'hvac_action', 'heating') -%}
  {%- set fenster = r.fenster is defined and is_state(r.fenster, 'on') -%}
  {%- set aus = is_state(c, 'off') -%}
  {%- set ziel = state_attr(c, 'temperature') -%}
  {%- set ziel_txt = ('%.1f' | format(ziel | float(0))) | replace('.', ',') -%}
  {%- set grund = 'Fenster offen' if fenster else ('Thermostat aus' if aus else ('Heizt auf ' ~ ziel_txt ~ '°' if heizt else 'Temperatur erreicht')) -%}
  {%- set ton = 'pause' if fenster else ('aus' if aus else ('heizt' if heizt else 'normal')) -%}
  {%- set ns.r = ns.r + [{
    'id': r.id, 'label': r.label, 'icon': '',
    'ist': state_attr(c, 'current_temperature'), 'feuchte': state_attr(c, 'current_humidity'),
    'ziel': ziel, 'heizt': heizt, 'fenster_offen': fenster,
    'wunsch': ziel, 'wunsch_entity': c,
    'wunsch_min': state_attr(c, 'min_temp') or 5, 'wunsch_max': state_attr(c, 'max_temp') or 30,
    'wunsch_schritt': state_attr(c, 'target_temp_step') or 0.5,
    'wunsch_gesperrt': aus or ziel is none,
    'betriebsart': 'automatik', 'grund': grund, 'ton': ton,
    'extras': [], 'infos': [], 'steuerung': [], 'hinweis': ''
  }] -%}
{%- endfor -%}
{{ {
  'version': 1,
  'haus': {
    'modus': '', 'modus_optionen': [], 'modus_entity': '', 'modus_hinweis': '',
    'aussen': state_attr(wetter, 'temperature'), 'wetter': states(wetter), 'tag': is_state('sun.sun', 'above_horizon'),
    'alles_aus': false, 'alles_aus_entity': '', 'pumpe_laeuft': false, 'letzte_aktion': '', 'fakten': [],
    'betriebsart_script': '', 'fernzugriff_url': ''
  },
  'raeume': ns.r
} }}
{%- endmacro -%}
